NODE_ENV=development

CLIENT_ID=
TOKEN=

GUILD_ID=

# Optional but recommended — a YouTube cookie string for the music player.
# Hosting providers' IPs are frequently blocked/challenged by YouTube, which
# makes music playback fail silently. An authenticated cookie avoids this.
# Get one via a browser extension like "Get cookies.txt" while logged into
# youtube.com, then paste the cookie header value here.
YOUTUBE_COOKIE=

# Optional — for movie/TV guessing games (free at themoviedb.org)
TMDB_API_KEY=

# Optional — for the video game guessing game (free at rawg.io/apidocs)
RAWG_API_KEY=

# The song guessing game uses Deezer's public API — no key needed

# Optional — lets ctiservers.org's Range spend coins on boosters and revives.
# A long random string (16+ chars); set the same value as ECONOMY_TOKEN on the
# Range leaderboard Worker. Served on WEB_PORT at /api/range, which must be
# reachable over HTTPS from the internet.
RANGE_API_TOKEN=
# Comma-separated user IDs banned from every server the bot is in. Keep real IDs out of git.
GLOBAL_BAN_IDS=

# Server-specific IDs (kept out of the repo). JSON on one line.
# The server linked roles apply in.
HOME_GUILD_ID=
# Parent roles given automatically to anyone with any of their child roles:
# [{"parent":"<role id>","children":["<role id>","<role id>"]}]
LINKED_ROLES=
# Buttons on /ticket redirect: [{"id":"<channel id>","label":"Admin Support"}]
TICKET_REDIRECT_CHANNELS=
