# --- Music bot ---
# This runs under the MAIN Jade bot's account: use the same token and application
# ID as the main bot (see README.md). It can also run as a separate application.

# Bot token. Leave blank to use the main bot's TOKEN from C:\TMCBot-PROD\secrets.env
# (start.ps1 reads it from there each time it starts).
TOKEN=

# Application (client) ID (the main bot's CLIENT_ID)
CLIENT_ID=

# Server to register /music in (main server: 337294816641679370). REQUIRED when
# sharing the main bot's token, so /music stays out of the main bot's global
# commands. Leave blank only for a separate application.
GUILD_ID=

# Optional: a YouTube cookie string to authenticate the session (helps with
# rate-limiting on busy bots). Leave blank to use the main bot's YOUTUBE_COOKIE.
YOUTUBE_COOKIE=
