# --- Music bot ---
# This runs under the MAIN Jade bot's account: use the same token and application
# ID as the main bot (see README.md). It can also run as a separate application.

# Bot token. Leave blank to use the main bot's TOKEN from C:\TMCBot-PROD\secrets.env
# (start.ps1 reads it from there each time it starts).
TOKEN=

# Application (client) ID (the main bot's CLIENT_ID)
CLIENT_ID=

# Server to register the music commands in (your main server's ID). REQUIRED when
# sharing the main bot's token, so the music commands stay out of the main bot's global
# commands. Leave blank only for a separate application.
GUILD_ID=

# Shared secret between the bot and its local Lavalink server. Leave it out:
# lavalink/setup-lavalink.ps1 generates a random one into .env on first run.
# LAVALINK_PASSWORD=

# YouTube sign-in for Lavalink. Leave it out: lavalink/setup-lavalink.ps1 saves it
# here after you sign in at google.com/device (see README.md). Keep it private.
# YOUTUBE_REFRESH_TOKEN=
