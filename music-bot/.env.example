# --- Standalone music bot ---
# This is a SEPARATE Discord application from the main bot. Create one at
# https://discord.com/developers/applications (see README.md for full steps).

# Bot token from the new application's "Bot" tab
TOKEN=

# Application (client) ID from the new application's "General Information" tab
CLIENT_ID=

# Optional: a YouTube cookie string to authenticate the session (helps with
# rate-limiting on busy bots). Same format as the main bot's YOUTUBE_COOKIE.
YOUTUBE_COOKIE=
